-- *******************************************************************************
-- ********************* ATS METRO TABLE *****************************************
atsMetroTable   OBJECT-TYPE
                SYNTAX      SEQUENCE OF SeqAtsMetroEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Ats Metrology Table"
                ::= { productAts 11 }

atsMetroEntry   OBJECT-TYPE
                SYNTAX      SeqAtsMetroEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Ats Metrology Details for given Product Index"
                INDEX  { atsMetroModbusAddress, atsMetroSourceIndex }
                ::= { atsMetroTable 1 }

atsMetroModbusAddress    OBJECT-TYPE
                SYNTAX      Unsigned32(1..255)
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Modbus address of the product"
                ::= { atsMetroEntry 1 }

atsMetroProductIndex    OBJECT-TYPE
                SYNTAX      Unsigned32(1..33)  -- 32 Products + 1 Gateway
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the Product to reach (1 = Gateway itself)"
                ::= { atsMetroEntry 5 }
				
atsMetroSourceIndex       OBJECT-TYPE
                SYNTAX      Unsigned32 (1..16)  -- multiplie sources
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the Source to reach"
                ::= { atsMetroEntry 6 }

atsMetroRowStatus      OBJECT-TYPE
                SYNTAX       RowStatus
                MAX-ACCESS   read-create
                STATUS       current
                DESCRIPTION "The status of this conceptual row."
                ::= { atsMetroEntry 10 }

atsMetroVoltPhPhU12Source   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Ph-Ph Voltage U12 of Source (1/100 V)"
                ::= { atsMetroEntry 110233 }  
                
atsMetroVoltPhPhU23Source   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Ph-Ph Voltage U23 of Source (1/100 V)"
                ::= { atsMetroEntry 110234 }  

atsMetroVoltPhPhU31Source   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Ph-Ph Voltage U31 of Source (1/100 V)"
                ::= { atsMetroEntry 110235 }  
                
atsMetroVoltPhNV1Source   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Ph-N Voltage V1 of Source (1/100 V)"
                ::= { atsMetroEntry 110228 }
                
atsMetroVoltPhNV2Source   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Ph-N Voltage V2 of Source (1/100 V)"
                ::= { atsMetroEntry 110229 }
                
atsMetroVoltPhNV3Source   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Ph-N Voltage V3 of Source (1/100 V)"
                ::= { atsMetroEntry 110230 }
                
atsMetroFrequencySource   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Frequency of Source (mHz)"
                ::= { atsMetroEntry 40014 }


                
-- *******************************************************************************
-- ********************* ATS STATUS TABLE ****************************************
atsStatusTable       OBJECT-TYPE
                SYNTAX      SEQUENCE OF SeqAtsStatusEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Ats Status Table"
                ::= { productAts 50 }

atsStatusEntry       OBJECT-TYPE
                SYNTAX      SeqAtsStatusEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Ats Status Details for given Product Index"
                INDEX  { atsStatusModbusAddress  }
                ::= { atsStatusTable 1 }

atsStatusModbusAddress    OBJECT-TYPE
                SYNTAX      Unsigned32(1..255)
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Modbus address of the product"
                ::= { atsStatusEntry 1 }

atsStatusProductIndex    OBJECT-TYPE
                SYNTAX      Unsigned32(1..33)  -- 32 Products + 1 Gateway
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the Product to reach (1 = Gateway itself)"
                ::= { atsStatusEntry 5 }

atsStatusRowStatus      OBJECT-TYPE
                SYNTAX       RowStatus
                MAX-ACCESS   read-create
                STATUS       current
                DESCRIPTION "The status of this conceptual row."
                ::= { atsStatusEntry 10 }

atsStatusSourcePrio   OBJECT-TYPE
                SYNTAX      SocomecAtsSourcePrio
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Source priority"
                ::= { atsStatusEntry 135000 }
                
atsStatusSwitchAlarmFaultCode   OBJECT-TYPE
                SYNTAX      SocomecAtsAlarmFault
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Alarm fault code"
                ::= { atsStatusEntry 135001 }
                
atsStatusSwitchOperatingMode   OBJECT-TYPE
                SYNTAX      SocomecAtsOperatingMode
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Operating Mode: 0 = Manual, 1 = Locked, 16 = Auto, 32 = Remote, 64 = Inhibit"
                ::= { atsStatusEntry 135038 }
                
atsStatusSwitchPosition   OBJECT-TYPE
                SYNTAX      SocomecAtsPosition
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Switch Position: 0 = Unknown, 1 = Position 0, 2 = Position 1, 3 = Position 2"
                ::= { atsStatusEntry 135039 }
                
atsStatusRelayStateSource1   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Generator relay State Source 1: 0 = Inactive, 1 = Active"
                ::= { atsStatusEntry 135041 }
                
atsStatusRelayStateSource2   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Generator relay State Source 2: 0 = Inactive, 1 = Active"
                ::= { atsStatusEntry 135042 }
                
atsStatusSwitchStateSource1   OBJECT-TYPE
