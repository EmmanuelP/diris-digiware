SOCOMEC-DIRIS-PRODUCTS-MIB DEFINITIONS ::= BEGIN

IMPORTS
    MODULE-COMPLIANCE, OBJECT-GROUP, NOTIFICATION-GROUP 
        FROM SNMPv2-CONF           
        
    MODULE-IDENTITY, OBJECT-TYPE, NOTIFICATION-TYPE,
    Integer32, Unsigned32, enterprises
        FROM SNMPv2-SMI
       
    DisplayString, RowStatus, StorageType
        FROM SNMPv2-TC;

    -- *******************************************************************************
    -- Definition of Socomec Enumerations ********************************************
    SocomecCircuitType ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Circuit Type"
        SYNTAX       INTEGER {  none(0),
                                e1PN-1CT(1),
                                e2P-1CT(2), e2PN-2CT(3),
                                e3P-1CT(4), e3P-2CT(5), e3P-3CT(6),
                                e3PN-1CT(7), e3PN-3CT(8), e3PN-4CT(9),
                                multifluid(10),
                                dc(11),
                                e1CT(12),e3CT(13),
                                isomFeeder(14),
                                rcm(15),ups(16)
                                }

    SocomecCircuitNature ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Circuit Nature"
        SYNTAX       INTEGER {  electricity(0),
                                gas(1),
                                water(2),
                                compressedAir(3),
                                fuel(4),
                                undefined(5),
                                fluid1(6),
                                fluid2(7),
                                fluid3(8),
                                custom(9)
                                }

    SocomecCircuitUsage ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Circuit Usage"
        SYNTAX       INTEGER {  heating(0),
                                ventilation(1),
                                airConditionning(2),
                                auxiliaryFanPump(3),
                                indoorLighting(4),
                                outdoorLighting(5),
                                socket(6),
                                hotWaterDomestic(7),
                                hotWater(8),
                                coldWater(9),
                                iceWater(10),
                                refrigeratingProduction(11),
                                photovoltaics(12),
                                wind(13),
                                it(14),
                                process(15),
                                usage1(16),
                                usage2(17),
                                usage3(18),
                                undefined(19),
                                custom(20),
                                insulation(21)
                                }

    SocomecBreakerPosition ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Breaker Position"
        SYNTAX       INTEGER { opened(0), closed(1), unknown(2), na(3) }

    SocomecTripStatus ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Trip Status"
        SYNTAX       INTEGER { noTrip(0), trip(1), unknown(2) }

    SocomecTripCause ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Trip Cause"
        SYNTAX       INTEGER { overcurrent(0), differential(1), bothOvercurrentDifferential(2), unknown(3) }

    SocomecBreakerFault ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Breaker fault"
        SYNTAX       INTEGER { none(0), fault(1) }

    SocomecModeDigitalIO ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for ditial mode"
        SYNTAX       INTEGER {  normallyOpen(0), normallyClosed(1) }

    SocomecModeAnalogIO ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for analog mode"
        SYNTAX       INTEGER {  e0-20mA(0), e4-20mA(1) }

    SocomecIOFunctions ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for IO functions"
        SYNTAX       INTEGER {  none(0),
                                -- Input Functions:
                                pulseMeter(3), logicalAlarm(4), alarmAck(5), breaker(9), extTopSynchro(10), tarif(11),
                                productTest(15), imdInjection(16), lciInjection(17),
                                forceOff(18), tokenDgw(19), tokenEth(20),
                                -- ATS input:
                                inh(21), inhp(22), inht(23), ton(24), tof(25), eon(26), eof(27), rtc(28), pri(29),
                                ss1(30), ss2(31), ale(32), fte(33), msr(36), oa1(37), oa2(38), ou1(39),
                                ou2(40), rst(41), lsi(42), ac1(43), ac2(44), ac0(45), ac0a(46), ac0b(47), man(48), lck(49),
                                chp(50), iee(51), pop(52), ps1(53), ps2(54), ps0(55), rt0(56), blk(57), tp1(58), tp2(59),
                                rec(60), est(61), ipi(62), ipb(63), bct(64), elb(65), is1(66), is2(67),
                                screen(100), shutter(101),
                             
                                -- Output Functions:
                                alarmReport(6), imdInjection(7), lciInjection (8) ,
                                loadShedding(12), energyPulse(13), topSynchroReport(14),

                                -- ATS output:
                                po1(70), po2(71), po0(72), pa0(73), pb0(74), gs1(75), gs2(76), s1a(77), s2a(78), sca(79),
                                s1u(80), s2u(81), ac1(82), ac2(83), ac0(84), lo1(85), lo2(86), lsc(87), flt(88), pop(89),
                                lck(90), cop(91), tos(92), eos(93), ros(94), pts(95), ees(96), tpp(97), tpt(98), ipt(99),
                                phi(100), co1(101), co2(102), co3(103), co4(104), co5(105), co6(106), eea(107), elv(108)
                                }

SocomecAtsSourcePrio ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Ats Source prio"
        SYNTAX       INTEGER {  network(0), source1(1), source2(2) }

SocomecAtsOperatingMode ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Ats Operating Mode"
        SYNTAX       INTEGER { manual(0), locked(1), auto(16), remote(32), inhibit(64) }

SocomecAtsPosition ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Ats Position"
        SYNTAX       INTEGER { unknown(0), position0(1), position1(2), position2(3) }

SocomecAtsStateSource ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Ats State of Source"
        SYNTAX       INTEGER { underThreshold(0), present(1), available(2) }

SocomecAtsTestInProgress ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Ats Test in progress"
        SYNTAX       INTEGER { none(0), tof(1), eof(2), tol(4), eol(8) }

SocomecAtsAlarmFault ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Ats alarm fault"
        SYNTAX       INTEGER {  none(0),
                                operatingFactor(1), neutralPosition(2),
                                fault1(3), fault2(4), alarm1(5), alarm2(6), rotationSource1(7), rotationSource2(8),
                                capaSource1(9), capaSource2(10), powerSource1(11), powerSource2(12),
                                position1(13), position2(14), position0(15), fault0(16),
                                unbalancedSource1(17), unbalancedSource2(18), mainFault(19),
                                motorFault(20), autoconfigurationFailed(21), unknownOrMultiple(255) }

SocomecAtsSwitchFaultSummary ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Ats Fault summary"
        SYNTAX       INTEGER {  none(0), alarm(1), fault(2) }

SocomecAtsSwitchLastCause ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Ats last switch cause"
        SYNTAX       INTEGER {  none(0), manual(1),
                                underVoltageSource1(2), underVoltageSource2(3), overVoltageSource1(4), overVoltageSource2(5),
                                underFrequenceSource1(6), underFrequenceSource2(7), overFrequenceSource1(8), overFrequenceSource2(9),
                                unbalancedSource1(10), unbalancedSource2(11), rotationSource1(12), rotationSource2(13),
                                prioritySource(14), remote(15) }

SocomecAlarmType ::= TEXTUAL-CONVENTION
        STATUS       current
        DESCRIPTION  "Socomec enumeration for Alarm Type"
        SYNTAX       INTEGER {  analogicalAlarms(1),logicalAlarms(2), combinationAlarms(3), en50160Alarms(4), inrushAlarms(5), 
                                systemAlarms(6), isomAlarms(7), customAlarms(8), booleanAlarms(9), rcmAlarms(10),
                                faultAlarms(11), comparisonAlarms(12) }

    -- *******************************************************************************
    -- Definition of Identification Entry ********************************************
    SeqIdentificationEnt ::= SEQUENCE {
                   identModbusAddress    Unsigned32,
                   identProductIndex     Unsigned32,
                   identProductRowStatus RowStatus,
				   identTypeProduct      Unsigned32,
                   identType             DisplayString,     -- IDeviceId
                   identSWVersion        DisplayString,     -- IMajorProdVersion.IMinorProdVersion.IRevisionProdVersion.IBuildProdVersion
                   identVersionBuildDate DisplayString,     -- IBuildDateProdVersion
                   identSerialAASS       Unsigned32,
                   identSerialSSTL       Unsigned32,
                   identSerialOrder      Unsigned32,
                   identSerialReserve    Unsigned32,
                   identOperatingCounter Unsigned32         -- Does Not Exist so far ...
                   }

    -- *******************************************************************************
    -- Definition of Circuit Entry ********************************************
    SeqCircuitEnt ::= SEQUENCE {
                   circuitIndex            Unsigned32,
                   circuitProductIndex     Unsigned32,
                   circuitProductLine      Unsigned32,
                   circuitProductModbusAddress Unsigned32,
                   circuitRowStatus        RowStatus,
                   circuitName             DisplayString,
                   circuitType             SocomecCircuitType,
                   circuitUsage            SocomecCircuitUsage,
                   circuitNature           SocomecCircuitNature,
                   circuitLocation         DisplayString,
                   }

    -- *******************************************************************************
    -- Definition of Metrology Load Curves Entry *************************************
    SeqLoadCurvesEnt ::= SEQUENCE {            
                   loadCurvesModbusAddress       Unsigned32,
                   loadCurvesProductIndex       Unsigned32,
                   loadCurvesLoadIndex          Unsigned32,
                   loadCurvesLoadRowStatus      RowStatus,
                   loadCurvesActivePowerPos     Unsigned32,
                   loadCurvesActivePowerNeg     Unsigned32,
                   loadCurvesReactivePowerPos   Unsigned32,
                   loadCurvesReactivePowerNeg   Unsigned32,
                   loadCurvesApparentPower      Unsigned32 
                   }

    -- *******************************************************************************
    -- Definition of Metrology Energy Entry
    SeqEnergyEnt ::= SEQUENCE {            
                   engModbusAddress      Unsigned32,
                   engProductIndex       Unsigned32,
                   engLoadIndex          Unsigned32,
                   engLoadRowStatus      RowStatus,
				   engTotalHourMeter                           Unsigned32,
                   engTotalEnergyActivePos                     Unsigned32,
                   engTotalEnergyActiveResidualPos             Unsigned32,
                   engTotalEnergyActiveNeg                     Unsigned32,
                   engTotalEnergyActiveResidualNeg             Unsigned32,
                   engTotalEnergyReactivePos                   Unsigned32,
                   engTotalEnergyReactiveResidualPos           Unsigned32,
                   engTotalEnergyReactiveNeg                   Unsigned32,
                   engTotalEnergyReactiveResidualNeg           Unsigned32,
                   engTotalEnergyApparent                      Unsigned32,
                   engTotalEnergyApparentResidual              Unsigned32,
                   engTotalEnergyReactiveLaggingPos            Unsigned32,
                   engTotalEnergyReactiveLaggingResidualPos    Unsigned32,
                   engTotalEnergyReactiveLaggingNeg            Unsigned32,
                   engTotalEnergyReactiveLaggingResidualNeg    Unsigned32,
                   engTotalEnergyReactiveLeadingPos            Unsigned32,
                   engTotalEnergyReactiveLeadingResidualPos    Unsigned32,
                   engTotalEnergyReactiveLeadingNeg            Unsigned32,
                   engTotalEnergyReactiveLeadingResidualNeg    Unsigned32,
                   engPartialHourMeter                         Unsigned32,
                   engPartialEnergyActivePos                   Unsigned32,
                   engPartialEnergyActiveResidualPos           Unsigned32,
                   engPartialEnergyActiveNeg                   Unsigned32,
                   engPartialEnergyActiveResidualNeg           Unsigned32,
                   engPartialEnergyReactivePos                 Unsigned32,
                   engPartialEnergyReactiveResidualPos         Unsigned32,
                   engPartialEnergyReactiveNeg                 Unsigned32,
                   engPartialEnergyReactiveResidualNeg         Unsigned32,
                   engPartialEnergyApparent                    Unsigned32,
                   engPartialEnergyApparentResidual            Unsigned32,
                   engLastPartialResetDate                     Unsigned32,
                   --engLastPartialHourMeter                   Unsigned32,
                   engLastPartialEnergyActivePos               Unsigned32,
                   engLastPartialEnergyActiveResidualPos       Unsigned32,
                   engLastPartialEnergyActiveNeg               Unsigned32,
                   engLastPartialEnergyActiveResidualNeg       Unsigned32,
                   engLastPartialEnergyReactivePos             Unsigned32,
                   engLastPartialEnergyReactiveResidualPos     Unsigned32,
                   engLastPartialEnergyReactiveNeg             Unsigned32,
                   engLastPartialEnergyReactiveResidualNeg     Unsigned32,
                   engLastPartialEnergyApparent                Unsigned32,
                   engLastPartialEnergyApparentResidual        Unsigned32
                   }

    -- *******************************************************************************
    -- Definition of Product Measurement Instantaneous Entry *************************
    -- Definition of Metrology Multifluid Entry
    SeqMultifluidEnt ::= SEQUENCE {            
                   mffModbusAddress      Unsigned32,
                   mffProductIndex       Unsigned32,
                   mffLoadIndex          Unsigned32,
                   mffLoadRowStatus      RowStatus,
                   mffTotalMeter         Integer32,
                   mffPartialMeter       Integer32,
                   mffUnit               DisplayString,
                   mffWeight             Integer32
                   }

    -- *******************************************************************************
    -- Definition of Product Measurement Instantaneous Entry *************************
    SeqInstantaneousEnt ::= SEQUENCE {            
                   instModbusAddress         Unsigned32,
                   instProductIndex         Unsigned32,
                   instLoadIndex            Unsigned32,
                   instLoadRowStatus        RowStatus,
                   --instDateLastInstance     Unsigned32,
                -- 1x ==> System Measurements
                   instVoltSystPhN          Unsigned32,
                   instVoltSystPhPh         Unsigned32,
                   instCurrentSyst          Unsigned32,
                   instFrequency            Unsigned32,
                -- 2x/3x ==> Voltage Measurements
                   instVoltPhNV1            Unsigned32,
                   instVoltPhNV2            Unsigned32,
                   instVoltPhNV3            Unsigned32,
                   instVoltPhNVn            Unsigned32,
                   instVoltPhPhU12          Unsigned32,
                   instVoltPhPhU23          Unsigned32,
                   instVoltPhPhU31          Unsigned32,
                -- 4x/5x ==> Current Measurements
                   instCurrentI1            Unsigned32,
                   instCurrentI2            Unsigned32,
                   instCurrentI3            Unsigned32, 
                   instCurrentIn            Unsigned32,
                   instCurrentInba          Unsigned32,
                   instCurrentIdir          Unsigned32,
                   instCurrentIinv          Unsigned32,
                   instCurrentIhom          Unsigned32,
                   instCurrentInb           Unsigned32,
                   instCurrentIdn           Unsigned32,
                   instCurrentIpe           Unsigned32,
                -- 6x/7x ==> Total Power Measurements
                   instPowerApparentNom     Unsigned32,
                   instTotalPowerActive     Integer32,
                   instTotalPowerReactive   Integer32,
                   instTotalPowerApparent   Unsigned32,
                   instTotalPowerFactor     Integer32,
                   instTotalPowerFactorType Unsigned32,
                -- 8x/9x ==> Phasis Power Measurements
                   instPowerActiveP1        Integer32,
                   instPowerActiveP2        Integer32,
                   instPowerActiveP3        Integer32,
                   instPowerReactiveQ1      Integer32,
                   instPowerReactiveQ2      Integer32,
                   instPowerReactiveQ3      Integer32,
                   instPowerApparentS1      Unsigned32,
                   instPowerApparentS2      Unsigned32,
                   instPowerApparentS3      Unsigned32,
                -- 10x ==> Power Factor Measurements
                   instPowerFactorPF1       Integer32,
                   instPowerFactorTypeSPF1  Unsigned32,
                   instPowerFactorPF2       Integer32,
                   instPowerFactorTypeSPF2  Unsigned32,
                   instPowerFactorPF3       Integer32,
                   instPowerFactorTypeSPF3  Unsigned32
                   }

    -- *******************************************************************************
    -- Definition of Averages Entry **************************************************
    SeqAveragesEnt ::= SEQUENCE {            
				   avgModbusAddress        Unsigned32,
                   avgProductIndex         Unsigned32,
                   avgLoadIndex            Unsigned32,
                   avgLoadRowStatus        RowStatus,
                   avgDateLastInstance     Unsigned32,
                -- 1x ==> System Measurements
                   avgVoltSystPhN          Unsigned32,
                   avgVoltSystPhPh         Unsigned32,
                   avgCurrentSyst          Unsigned32,
                   avgFrequency            Unsigned32,
                -- 2x/3x ==> Voltage Measurements
                   avgVoltPhNV1            Unsigned32,
                   avgVoltPhNV2            Unsigned32,
                   avgVoltPhNV3            Unsigned32,
                   avgVoltPhNVn            Unsigned32,
                   avgVoltPhPhU12          Unsigned32,
                   avgVoltPhPhU23          Unsigned32,
                   avgVoltPhPhU31          Unsigned32,
                -- 4x/5x ==> Current Measurements
                   avgCurrentI1            Unsigned32,
                   avgCurrentI2            Unsigned32,
                   avgCurrentI3            Unsigned32, 
                   avgCurrentIn            Unsigned32,
                   avgCurrentInba          Unsigned32,
                   avgCurrentIdir          Unsigned32,
                   avgCurrentIinv          Unsigned32,
                   avgCurrentIhom          Unsigned32,
                   avgCurrentInb           Unsigned32,
                -- 6x/7x ==> Total Power Measurements
                   avgTotalPowerActive     Integer32,
                   avgTotalPowerReactive   Integer32,
                   avgTotalPowerApparent   Unsigned32,
                   avgTotalPowerFactor     Integer32,
                   avgTotalPowerFactorType Unsigned32,
                -- 8x/9x ==> Phasis Power Measurements
                   avgPowerActiveP1        Integer32,
                   avgPowerActiveP2        Integer32,
                   avgPowerActiveP3        Integer32,
                   avgPowerReactiveQ1      Integer32,
                   avgPowerReactiveQ2      Integer32,
                   avgPowerReactiveQ3      Integer32,
                   avgPowerApparentS1      Unsigned32,
                   avgPowerApparentS2      Unsigned32,
                   avgPowerApparentS3      Unsigned32,
                -- 10x ==> Power Factor Measurements
                   avgPowerFactorPF1       Integer32,
                   avgPowerFactorTypeSPF1  Unsigned32,
                   avgPowerFactorPF2       Integer32,
                   avgPowerFactorTypeSPF2  Unsigned32,
                   avgPowerFactorPF3       Integer32,
                   avgPowerFactorTypeSPF3  Unsigned32
                   }

    -- *******************************************************************************
    -- Definition of Product Measurement Max Instantaneous Entry *********************
    SeqMaxInstantaneousEnt ::= SEQUENCE {            
                   maxInstModbusAddress         Unsigned32,
                   maxInstProductIndex         Unsigned32,
                   maxInstLoadIndex            Unsigned32,
                   maxInstLoadRowStatus        RowStatus,
                -- 1x ==> System Measurements
                   maxInstFrequency            Unsigned32,
                   maxInstFrequencyDate        Unsigned32,
                -- 2x/3x ==> Voltage Measurements
                   maxInstVoltPhNV1            Unsigned32,
                   maxInstVoltPhNV1Date        Unsigned32,
                   maxInstVoltPhNV2            Unsigned32,
                   maxInstVoltPhNV2Date        Unsigned32,
                   maxInstVoltPhNV3            Unsigned32,
                   maxInstVoltPhNV3Date        Unsigned32,
                   maxInstVoltPhNVn            Unsigned32,
                   maxInstVoltPhNVnDate        Unsigned32,
                   maxInstVoltPhPhU12          Unsigned32,
                   maxInstVoltPhPhU12Date      Unsigned32,
                   maxInstVoltPhPhU23          Unsigned32,
                   maxInstVoltPhPhU23Date      Unsigned32,
                   maxInstVoltPhPhU31          Unsigned32,
                   maxInstVoltPhPhU31Date      Unsigned32,
                -- 4x/5x ==> Current Measurements
                   maxInstCurrentI1            Unsigned32, 
                   maxInstCurrentI1Date        Unsigned32,
                   maxInstCurrentI2            Unsigned32, 
                   maxInstCurrentI2Date        Unsigned32,
                   maxInstCurrentI3            Unsigned32, 
                   maxInstCurrentI3Date        Unsigned32, 
                   maxInstCurrentIn            Unsigned32, 
                   maxInstCurrentInDate        Unsigned32,
                -- 6x/7x ==> Total Power Measurements
                   maxInstTotalPowerActive         Integer32,  
                   maxInstTotalPowerActiveDate     Unsigned32,
                   maxInstTotalPowerReactive       Integer32,
                   maxInstTotalPowerReactiveDate   Unsigned32,
                   maxInstTotalPowerApparent       Unsigned32, 
                   maxInstTotalPowerApparentDate   Unsigned32,
                   maxInstTotalPowerFactor         Integer32,
                   maxInstTotalPowerFactorType     Unsigned32,
                   maxInstTotalPowerFactorDate     Unsigned32,
                -- 8x/9x ==> Phasis Power Measurements
                   maxInstPowerActiveP1        Integer32,
                   maxInstPowerActiveP1Date    Unsigned32,
                   maxInstPowerActiveP2        Integer32,
                   maxInstPowerActiveP2Date    Unsigned32,
                   maxInstPowerActiveP3        Integer32,
                   maxInstPowerActiveP3Date    Unsigned32,
                   maxInstPowerReactiveQ1      Integer32,
                   maxInstPowerReactiveQ1Date  Unsigned32,
                   maxInstPowerReactiveQ2      Integer32,
                   maxInstPowerReactiveQ2Date  Unsigned32,
                   maxInstPowerReactiveQ3      Integer32,
                   maxInstPowerReactiveQ3Date  Unsigned32,
                   maxInstPowerApparentS1      Unsigned32,
                   maxInstPowerApparentS1Date  Unsigned32,
                   maxInstPowerApparentS2      Unsigned32,
                   maxInstPowerApparentS2Date  Unsigned32,
                   maxInstPowerApparentS3      Unsigned32,
                   maxInstPowerApparentS3Date  Unsigned32,
                -- 10x ==> Power Factor Measurements
                   maxInstPowerFactorPF1       Integer32, 
                   maxInstPowerFactorTypeSPF1  Unsigned32,
                   maxInstPowerFactorPF1Date   Unsigned32, 
                   maxInstPowerFactorPF2       Integer32, 
                   maxInstPowerFactorTypeSPF2  Unsigned32,
                   maxInstPowerFactorPF2Date   Unsigned32,
                   maxInstPowerFactorPF3       Integer32,
                   maxInstPowerFactorTypeSPF3  Unsigned32,
                   maxInstPowerFactorPF3Date   Unsigned32
                   }

    -- *******************************************************************************
    -- Definition of Product Measurement Min Instantaneous Entry *********************
    SeqMinInstantaneousEnt ::= SEQUENCE {
                    minInstModbusAddress            Unsigned32,
                    minInstProductIndex             Unsigned32,
                    minInstLoadIndex                Unsigned32,
                    minInstLoadRowStatus            RowStatus,
                --  1x ==> System Measurements
                    minInstFrequency                Unsigned32,
                    minInstFrequencyDate            Unsigned32,
                --  2x/3x ==> Voltage Measurements
                    minInstVoltPhNV1                Unsigned32,
                    minInstVoltPhNV1Date            Unsigned32,
                    minInstVoltPhNV2                Unsigned32,
                    minInstVoltPhNV2Date            Unsigned32,
                    minInstVoltPhNV3                Unsigned32,
                    minInstVoltPhNV3Date            Unsigned32,
                    minInstVoltPhNVn                Unsigned32,
                    minInstVoltPhNVnDate            Unsigned32,
                    minInstVoltPhPhU12              Unsigned32,
                    minInstVoltPhPhU12Date          Unsigned32,
                    minInstVoltPhPhU23              Unsigned32,
                    minInstVoltPhPhU23Date          Unsigned32,
                    minInstVoltPhPhU31              Unsigned32,
                    minInstVoltPhPhU31Date          Unsigned32,
                --  4x/5x ==> Current Measurements
                    minInstCurrentI1                Unsigned32,
                    minInstCurrentI1Date            Unsigned32,
                    minInstCurrentI2                Unsigned32,
                    minInstCurrentI2Date            Unsigned32,
                    minInstCurrentI3                Unsigned32,
                    minInstCurrentI3Date            Unsigned32,
                    minInstCurrentIn                Unsigned32,
                    minInstCurrentInDate            Unsigned32,
                --  6x/7x ==> Total Power Measurements
                    minInstTotalPowerActive         Integer32,
                    minInstTotalPowerActiveDate     Unsigned32,
                    minInstTotalPowerReactive       Integer32,
                    minInstTotalPowerReactiveDate   Unsigned32,
                    minInstTotalPowerApparent       Unsigned32,
                    minInstTotalPowerApparentDate   Unsigned32,
                    minInstTotalPowerFactor         Integer32,
                    minInstTotalPowerFactorType     Unsigned32,
                    minInstTotalPowerFactorDate     Unsigned32,
                --  8x/9x ==> Phasis Power Measurements
                    minInstPowerActiveP1            Integer32,
                    minInstPowerActiveP1Date        Unsigned32,
                    minInstPowerActiveP2            Integer32,
                    minInstPowerActiveP2Date        Unsigned32,
                    minInstPowerActiveP3            Integer32,
                    minInstPowerActiveP3Date        Unsigned32,
                    minInstPowerReactiveQ1          Integer32,
                    minInstPowerReactiveQ1Date      Unsigned32,
                    minInstPowerReactiveQ2          Integer32,
                    minInstPowerReactiveQ2Date      Unsigned32,
                    minInstPowerReactiveQ3          Integer32,
                    minInstPowerReactiveQ3Date      Unsigned32,
                    minInstPowerApparentS1          Unsigned32,
                    minInstPowerApparentS1Date      Unsigned32,
                    minInstPowerApparentS2          Unsigned32,
                    minInstPowerApparentS2Date      Unsigned32,
                    minInstPowerApparentS3          Unsigned32,
                    minInstPowerApparentS3Date      Unsigned32,
                --  10x ==> Power Factor Measurements
                    minInstPowerFactorPF1           Integer32, 
                    minInstPowerFactorTypeSPF1      Unsigned32,
                    minInstPowerFactorPF1Date       Unsigned32,
                    minInstPowerFactorPF2           Integer32,
                    minInstPowerFactorTypeSPF2      Unsigned32,
                    minInstPowerFactorPF2Date       Unsigned32,
                    minInstPowerFactorPF3           Integer32,
                    minInstPowerFactorTypeSPF3      Unsigned32,
                    minInstPowerFactorPF3Date       Unsigned32
                   }

    -- *******************************************************************************
    -- Definition of Product Metrology Max Averages Entry
    SeqMaxAveragesEnt ::= SEQUENCE {            
                   maxAvgModbusAddress         Unsigned32,
                   maxAvgProductIndex         Unsigned32,
                   maxAvgLoadIndex            Unsigned32,
                   maxAvgLoadRowStatus        RowStatus,
                -- 1x ==> System Measurements
                   maxAvgFrequency            Unsigned32,
                   maxAvgFrequencyDate        Unsigned32,
                -- 2x/3x ==> Voltage Measurements
                   maxAvgVoltPhNV1            Unsigned32,
                   maxAvgVoltPhNV1Date        Unsigned32,
                   maxAvgVoltPhNV2            Unsigned32,
                   maxAvgVoltPhNV2Date        Unsigned32,
                   maxAvgVoltPhNV3            Unsigned32,
                   maxAvgVoltPhNV3Date        Unsigned32,
                   maxAvgVoltPhNVn            Unsigned32,
                   maxAvgVoltPhNVnDate        Unsigned32,
                   maxAvgVoltPhPhU12          Unsigned32,
                   maxAvgVoltPhPhU12Date      Unsigned32,
                   maxAvgVoltPhPhU23          Unsigned32,
                   maxAvgVoltPhPhU23Date      Unsigned32,
                   maxAvgVoltPhPhU31          Unsigned32,
                   maxAvgVoltPhPhU31Date      Unsigned32,
                -- 4x/5x ==> Current Measurements
                   maxAvgCurrentI1            Unsigned32, 
                   maxAvgCurrentI1Date        Unsigned32,
                   maxAvgCurrentI2            Unsigned32, 
                   maxAvgCurrentI2Date        Unsigned32,
                   maxAvgCurrentI3            Unsigned32, 
