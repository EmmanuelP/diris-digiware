socomec-diris-products-MIB MODULE-IDENTITY
    LAST-UPDATED "202408211200Z"
    ORGANIZATION "Socomec Software"
    CONTACT-INFO "SOCOMEC"
    DESCRIPTION  "MIB Definition for Socomec Diris Products"

    REVISION    "202408211200Z"
    DESCRIPTION  "Added Circuit Table"
    REVISION    "201903261200Z"
    DESCRIPTION  "Added Command Chapter"
    REVISION    "201902011200Z"
    DESCRIPTION "Added New ATS metro table"
    REVISION    "201706271200Z"
    DESCRIPTION "Added DC Metrology"
    REVISION    "201706161200Z"
    DESCRIPTION "Added ATS Tables"
    REVISION    "201606081200Z"
    DESCRIPTION "Initial Version"
    ::= { socomecModules 10 }

    socomec               OBJECT IDENTIFIER ::= { enterprises 4555 }
    socomecProducts       OBJECT IDENTIFIER ::= { socomec 10 }
    socomecModules        OBJECT IDENTIFIER ::= { socomec 80 }
    socomecMIBConformance OBJECT IDENTIFIER ::= { socomec 90 }
    productIdentification OBJECT IDENTIFIER ::= { socomecProducts 10 }
    productMetrology      OBJECT IDENTIFIER ::= { socomecProducts 20 }
    productStates         OBJECT IDENTIFIER ::= { socomecProducts 30 }
    productCommand        OBJECT IDENTIFIER ::= { socomecProducts 80 }
    productTraps          OBJECT IDENTIFIER ::= { socomecProducts 90 }
    productAts            OBJECT IDENTIFIER ::= { socomecProducts 40 }
    
	
	

-- *******************************************************************************
-- ********************* PRODUCT IDENTIFICATION TABLE ****************************
identificationTable    OBJECT-TYPE
                SYNTAX      SEQUENCE OF SeqIdentificationEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Product identification Table"
                ::= { productIdentification 10 }

identificationEntry    OBJECT-TYPE
                SYNTAX      SeqIdentificationEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Identification Table for given Product Index"
                INDEX  { identModbusAddress }
