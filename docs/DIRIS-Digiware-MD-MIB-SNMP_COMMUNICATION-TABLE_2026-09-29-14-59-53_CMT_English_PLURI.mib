instCurrentTHDLoadIndex       OBJECT-TYPE
                SYNTAX      Unsigned32(1..16)  -- 6 Loads + 10 MultiFluids
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the Load to reach"
                ::= { instantaneousCurrentTHDEntry 6 }

instCurrentTHDLoadRowStatus      OBJECT-TYPE
                SYNTAX       RowStatus
                MAX-ACCESS   read-create
                STATUS       current
                DESCRIPTION "The status of this conceptual row."
                ::= { instantaneousCurrentTHDEntry 10 }

