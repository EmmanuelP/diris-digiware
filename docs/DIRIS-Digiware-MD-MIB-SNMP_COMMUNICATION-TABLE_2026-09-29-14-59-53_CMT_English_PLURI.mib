                MAX-ACCESS  read-write
                STATUS      current
                DESCRIPTION "Command to active the output"
                ::= { outputDigitalEntry 85178 } 


-- *******************************************************************************
-- ********************* PROTECTION TABLE ****************************************
protectionTable OBJECT-TYPE
                SYNTAX      SEQUENCE OF SeqProtectionEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Table of Protections"
                ::= { productStates 3 }

protectionEntry       OBJECT-TYPE
                SYNTAX      SeqProtectionEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Protection for given Product Modbus Address and protect line"
                INDEX  { protectionModbusAddress, protectionProtectIndex }				
                ::= { protectionTable 1 }

protectionModbusAddress    OBJECT-TYPE
                SYNTAX      Unsigned32(1..255)
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Modbus address of the product"
                ::= { protectionEntry 1 }

protectionProductIndex    OBJECT-TYPE
                SYNTAX      Unsigned32(1..33)  -- 32 Products + 1 Gateway
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the Product to reach (1 = Gateway itself)"
                ::= { protectionEntry 5 }

protectionProtectIndex       OBJECT-TYPE
                SYNTAX      Unsigned32(1..6)  -- 6 Protects max
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the protect line to reach"
                ::= { protectionEntry 7 }
				
protectionRowStatus      OBJECT-TYPE
                SYNTAX       RowStatus
                MAX-ACCESS   read-create
                STATUS       current
                DESCRIPTION "The status of this conceptual row."
                ::= { protectionEntry 10 }

protectionPosition       OBJECT-TYPE
                SYNTAX      SocomecBreakerPosition
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Position state"
                ::= { protectionEntry 90007 }
protectionTripStatus       OBJECT-TYPE
                SYNTAX      SocomecTripStatus
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Trip status"
                ::= { protectionEntry 90008 }
protectionDefectiveDeviceStatus       OBJECT-TYPE
                SYNTAX      SocomecBreakerFault
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Status of the protection device"
                ::= { protectionEntry 136012 }
protectionTripCause       OBJECT-TYPE
                SYNTAX      SocomecTripCause
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Trip cause of the protection"
                ::= { protectionEntry 90136 }
protectionRCDDeviceFault       OBJECT-TYPE
                SYNTAX      SocomecBreakerFault
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Residual currend device fault"
                ::= { protectionEntry 90137 }
protectionPole1Position       OBJECT-TYPE
                SYNTAX      SocomecBreakerPosition
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Position of Pole 1"
                ::= { protectionEntry 136003 }
protectionPole2Position       OBJECT-TYPE
                SYNTAX      SocomecBreakerPosition
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Position of Pole 2"
                ::= { protectionEntry 136004 }
protectionPole3Position       OBJECT-TYPE
                SYNTAX      SocomecBreakerPosition
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Position of Pole 3"
                ::= { protectionEntry 136005 }

protectionTotalOperationCount       OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Total Count"
                ::= { protectionEntry 136011 }
protectionLowLoadOperationCount       OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Low load Count"
                ::= { protectionEntry 136007 }
protectionOnLoadOperationCount       OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "On load Count"
                ::= { protectionEntry 136008 }
protectionOverLoadOperationCount       OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Over load Count"
                ::= { protectionEntry 136009 }
protectionTripCount       OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Trip Count"
                ::= { protectionEntry 90009 }
protectionLastTripDate       OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Last Trip Date"
                ::= { protectionEntry 90072 }


