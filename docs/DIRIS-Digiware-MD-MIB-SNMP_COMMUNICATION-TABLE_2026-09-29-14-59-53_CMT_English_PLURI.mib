                   dcMaxInstTotalPowerActive        Integer32  ,
                   dcMaxInstTotalPowerActiveDate    Unsigned32 ,
                   dcMinAvgTotalPowerActive         Integer32  ,
                   dcMinAvgTotalPowerActiveDate     Unsigned32 ,
