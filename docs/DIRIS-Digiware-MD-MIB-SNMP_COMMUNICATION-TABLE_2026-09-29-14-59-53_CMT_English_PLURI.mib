                MAX-ACCESS   read-create
                STATUS       current
                DESCRIPTION "The status of this conceptual row."
                ::= { outputDigitalEntry 10 }

outputDigitalFunction   OBJECT-TYPE
                SYNTAX      SocomecIOFunctions
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "output function"
