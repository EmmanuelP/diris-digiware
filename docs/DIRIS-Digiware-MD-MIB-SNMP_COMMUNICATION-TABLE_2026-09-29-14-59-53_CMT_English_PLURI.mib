-- ********************* DIGITAL INPUT TABLE *************************************
inputDigitalTable       OBJECT-TYPE
                SYNTAX      SEQUENCE OF SeqDigInputEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Table of Digital Inputs"
                ::= { productStates 1 }

inputDigitalEntry       OBJECT-TYPE
                SYNTAX      SeqDigInputEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Digital Input Details for given Product Modbus Address and Input line"
                INDEX  { inputDigitalModbusAddress, inputDigitalLineIndex  }
                ::= { inputDigitalTable 1 }

inputDigitalModbusAddress    OBJECT-TYPE
                SYNTAX      Unsigned32(1..255)
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Modbus address of the product"
                ::= { inputDigitalEntry 1 }

inputDigitalProductIndex    OBJECT-TYPE
                SYNTAX      Unsigned32(1..33)  -- 32 Products + 1 Gateway
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the Product to reach (1 = Gateway itself)"
                ::= { inputDigitalEntry 5 }

inputDigitalLineIndex       OBJECT-TYPE
                SYNTAX      Unsigned32(1..10)  -- 10 Inputs max
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the Line to reach"
                ::= { inputDigitalEntry 7 }

inputDigitalRowStatus      OBJECT-TYPE
                SYNTAX       RowStatus
                MAX-ACCESS   read-create
                STATUS       current
                DESCRIPTION "The status of this conceptual row."
                ::= { inputDigitalEntry 10 }

inputDigitalFunction   OBJECT-TYPE
                SYNTAX      SocomecIOFunctions
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Input function"
                ::= { inputDigitalEntry 85086 } 
inputDigitalActivated   OBJECT-TYPE
                SYNTAX      Unsigned32(0..1)
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Line state is active"
                ::= { inputDigitalEntry 90002 } 
inputDigitalMode      OBJECT-TYPE
                SYNTAX      SocomecModeDigitalIO
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Input Normal state (0=NO / 1=NC)"
                ::= { inputDigitalEntry 90003 } 

