                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS State of Source 1"
                ::= { atsStatusEntry 135044 }
                
atsStatusSwitchStateSource2   OBJECT-TYPE
                SYNTAX      SocomecAtsStateSource
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS State of Source 2"
                ::= { atsStatusEntry 135045 }
                
atsStatusSwitchTestInProgress   OBJECT-TYPE
                SYNTAX      SocomecAtsTestInProgress
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Test in progress status"
                ::= { atsStatusEntry 135046 }
                
atsStatusCycleCounter   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS "
                ::= { atsStatusEntry 135048 }
                
atsStatusOperationCounterPos1   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Position 2 counter"
                ::= { atsStatusEntry 135049 }
                
atsStatusOperationCounterPos2   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Position 2 counter"
                ::= { atsStatusEntry 135050 }
                
atsStatusSwitchFaultSummary   OBJECT-TYPE
                SYNTAX      SocomecAtsSwitchFaultSummary
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS Fault summary"
                ::= { atsStatusEntry 135052 }
                
atsStatusSwitchLastCause   OBJECT-TYPE
                SYNTAX      SocomecAtsSwitchLastCause
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "ATS last switch-over cause"
                ::= { atsStatusEntry 135053 }

		 
-- *******************************************************************************
-- ********************* ATS METRO TABLE (LEGAY TABLE) ***************************
commandTable   OBJECT-TYPE
                SYNTAX      SEQUENCE OF SeqProductCommandEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Product Command Table"
                ::= { productCommand 10 }

commandEntry   OBJECT-TYPE
                SYNTAX      SeqProductCommandEnt
                MAX-ACCESS  not-accessible
                STATUS      current
                DESCRIPTION "Command Entry for given Product Index"
                INDEX  { commandModbusAddress, commandLineIndex }
                ::= { commandTable 1 }

commandModbusAddress    OBJECT-TYPE
                SYNTAX      Unsigned32(1..255)
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Modbus address of the product to command"
                ::= { commandEntry 1 }

commandProductIndex    OBJECT-TYPE
                SYNTAX      Unsigned32(1..33)  -- 32 Products + 1 Gateway
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the Product to reach (1 = Gateway itself)"
                ::= { commandEntry 5 }

commandLineIndex       OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-only
                STATUS      current
                DESCRIPTION "Index of the Line to reach"
                ::= { commandEntry 6 }

commandRowStatus      OBJECT-TYPE
                SYNTAX       RowStatus
                MAX-ACCESS   read-create
                STATUS       current
                DESCRIPTION "The status of this conceptual row."
                ::= { commandEntry 10 }

commandAtsGensetStartOrder   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-write
                STATUS      current
                DESCRIPTION "Command for Genset start order. 0 = GS1 start, 1 = GS1 stop, 2 = GS2 start, 3 = GS2 stop"
                ::= { commandEntry 156039 }

commandAtsPosition   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-write
                STATUS      current
                DESCRIPTION "Command to set Ats Position. 1	= Position in Zero, 2 = Position in 1, 3 = Position in 2"
                ::= { commandEntry 156018 }

commandAtsPriorityMode   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-write
                STATUS      current
                DESCRIPTION "Command to set Ats Priority Mode. 0 = Network, 1 = Source 1, 2 = Source 2"
                ::= { commandEntry 156017 }

commandAtsOperatingMode   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-write
                STATUS      current
                DESCRIPTION "Command to set Ats Operating Mode. 3 = Auto, 4 = Inhibit, 5 = Remote Control"
                ::= { commandEntry 156016 }

commandAtsCommandAlarm   OBJECT-TYPE
                SYNTAX      Unsigned32
                MAX-ACCESS  read-write
                STATUS      current
                DESCRIPTION "Command for Ats Alarm. 1 = Set RTE (By Keyboard), 2 = Clear TOF (By Keyboard), 3 = Set TOF (By Keyboard), 4 = Set TON (By Keyboard),
							5 = Set EOF (By input), 6 = Set EON (By input), 7 = Clear EOF (By input), 8 = Clear EON (By input), 10 = Clear TON (By Keyboard),
							16 = Clear Alarms/Faults (By input), 21 = Set EST Reset (By keyboard)"
                ::= { commandEntry 156015 }
				
